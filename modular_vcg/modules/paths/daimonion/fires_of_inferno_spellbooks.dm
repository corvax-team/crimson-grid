// fires of inferno spellbooks
/obj/item/path_spellbook/fires_of_inferno
	name = "fires of inferno spellbook"
	desc = "Том, хранящий тайны власти над адским пламенем, которую дарует демоническая магия."
	icon = 'modular_vcg/modules/paths/icons/paths.dmi'
	icon_state = "inferno_spellbook"
	path_type = /datum/discipline/path/inferno
	required_discipline = /datum/discipline/daimonion

/obj/item/path_spellbook/fires_of_inferno/level1
	name = "fires of inferno spellbook (level I)"
	desc = "Начальный том, излагающий основы управления адским пламенем. Открывает тауматургу силу \"Зажигалка\"."
	path_level = 1

/obj/item/path_spellbook/fires_of_inferno/level2
	name = "fires of inferno spellbook (level II)"
	desc = "Том для продолжающих, раскрывающий более глубокие тайны власти над адским пламенем. Открывает тауматургу силу \"Конфорка\"."
	path_level = 2

/obj/item/path_spellbook/fires_of_inferno/level3
	name = "fires of inferno spellbook (level III)"
	desc = "Том для сведущих, содержащий опасные приёмы магии адского пламени. Открывает тауматургу силу \"Паяльная лампа\"."
	path_level = 3

/obj/item/path_spellbook/fires_of_inferno/level4
	name = "fires of inferno spellbook (level IV)"
	desc = "Том для мастеров, описывающий сокрушительные силы адского пламени. Открывает тауматургу силу \"Огнемёт\"."
	path_level = 4

/obj/item/path_spellbook/fires_of_inferno/level5
	name = "fires of inferno spellbook (level V)"
	desc = "Вершина искусства адского пламени: том с самыми могущественными его приёмами. Открывает тауматургу силу \"Пожарище\"."
	path_level = 5
