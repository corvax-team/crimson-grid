/obj/item/path_spellbook/taking_of_spirit/level4
	name = "taking of spirit spellbook (level IV)"
	desc = "Том для мастеров, описывающий сокрушительные силы, что отнимают дух."
	path_level = 4

/obj/item/path_spellbook/taking_of_spirit/level5
	name = "taking of spirit spellbook (level V)"
	desc = "Вершина искусства власти над волей: том с самыми могущественными приёмами похищения духа."
	path_level = 5
