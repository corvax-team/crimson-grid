// levinbolt spellbooks
/obj/item/path_spellbook/levinbolt
	name = "levinbolt spellbook"
	desc = "Том, хранящий тайны власти над молнией, которую дарует магия крови."
	icon_state = "levinbolt_spellbook"
	path_type = /datum/discipline/path/levinbolt

/obj/item/path_spellbook/levinbolt/level1
	name = "levinbolt spellbook (level I)"
	desc = "Начальный том, излагающий основы управления молнией. Открывает тауматургу силу \"Искра\"."
	path_level = 1

/obj/item/path_spellbook/levinbolt/level2
	name = "levinbolt spellbook (level II)"
	desc = "Том для продолжающих, раскрывающий более глубокие тайны власти над электричеством. Открывает тауматургу силу \"Озарение\"."
	path_level = 2

/obj/item/path_spellbook/levinbolt/level3
	name = "levinbolt spellbook (level III)"
	desc = "Том для сведущих, содержащий опасные приёмы магии молний. Открывает тауматургу силу \"Силовой разряд\"."
	path_level = 3

/obj/item/path_spellbook/levinbolt/level4
	name = "levinbolt spellbook (level IV)"
	desc = "Том для мастеров, описывающий сокрушительные электрические силы. Открывает тауматургу силу \"Ярость Зевса\"."
	path_level = 4

/obj/item/path_spellbook/levinbolt/level5
	name = "levinbolt spellbook (level V)"
	desc = "Вершина искусства молний: том с самыми могущественными приёмами власти над электричеством. Открывает тауматургу силу \"Око бури\"."
	path_level = 5
